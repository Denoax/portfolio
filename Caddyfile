{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	log {
		output stdout
		format console
	}

	@fingerprinted path_regexp fingerprinted ^/assets/.+-[A-Za-z0-9_-]{8,}\.[^/]+$
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /assets/* {
		file_server
	}

	handle {
		route {
			try_files {path} /index.html

			@index path /index.html
			header @index Cache-Control "no-cache, no-store, must-revalidate"

			file_server
		}
	}
}
